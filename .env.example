# Bu dosyayı .env.local olarak kopyalayıp doldurun. .env.local git'e girmez.

# --- Medya CDN (Bunny.net) ---
# Sonunda / olmadan. Boş bırakılırsa görseller public/ altından okunur.
VITE_MEDIA_CDN_URL=https://luzayn.b-cdn.net

# --- Site adresi ---
# iyzico callbackUrl'i buradan üretilir. Boş bırakılırsa isteğin origin'i kullanılır.
PUBLIC_SITE_URL=https://luzayn.com

# --- iyzico (ARTIK KULLANILMIYOR: ödeme Shopify checkout'unda) ---
# Sandbox: https://sandbox-api.iyzipay.com
# Canlı:   https://api.iyzipay.com
IYZICO_URI=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# --- Resend: ARTIK KULLANILMIYOR (kendi SMTP'mize gecildi) ---
RESEND_API_KEY=
# Doğrulanmış gönderici alan adı, örn. "Luzayn <bildirim@luzayn.com>"
CONTACT_FROM_EMAIL=
# Formların düşeceği adres
CONTACT_TO_EMAIL=info@luzayn.com

# --- Shopify (ödeme Shopify checkout'unda tamamlanır) ---
# Mağazanın myshopify adresi, protokolsüz.
SHOPIFY_STORE_DOMAIN=98bz0t-kv.myshopify.com
# Storefront API public access token. Shopify admin > Ayarlar > Uygulamalar ve
# satış kanalları > Uygulama geliştir > Storefront API. VITE_ öneki YOK —
# yalnızca sunucuda kullanılır, tarayıcıya inmez.
# Headless kanalindan: "private access token" (sunucu tarafi, tercih edilen)
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Alternatif: "public access token". Ikisinden biri yeterli.
SHOPIFY_STOREFRONT_TOKEN=
# İsteğe bağlı; boşsa 2026-07 kullanılır.
SHOPIFY_API_VERSION=


# --- İçerik veritabanı (Supabase) ---
#
# Ürün kataloğu, blog, SSS, ana sayfa vitrini ve iletişim mesajları buradan
# okunur/yazılır. Şema ve kurulum talimatı yönetim paneli deposunda:
# luzayn-admin/supabase/*.sql
#
# ANON anahtar kullanılır ve tarayıcıya açılması normaldir: yetkisi RLS
# politikalarıyla sınırlıdır ve storefront hiç giriş yapmaz, yani yalnızca
# "yayında" işaretli satırları görür.
#
# service_role / secret anahtarı BURAYA YAZILMAZ — RLS'i tamamen bypass eder.
#
# Supabase Dashboard > Project Settings > API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- SMTP (kendi sunucunuz: DirectAdmin / cPanel) ---
# Ornek: mail.luzayn.com  |  465 = SSL, 587 = STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@luzayn.com
SMTP_PASS=
# Gorunen gonderen. Bos birakilirsa SMTP_USER kullanilir.
SMTP_FROM=Luzayn <noreply@luzayn.com>

# --- Analitik (VITE_ onekli: tarayiciya iner, gizli degil) ---
# GA4 olcum kimligi, ornek: G-XXXXXXXXXX
VITE_GA4_ID=
# Meta Pixel kimligi (sadece rakam)
VITE_META_PIXEL_ID=
